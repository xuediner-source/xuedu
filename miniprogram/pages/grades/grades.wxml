<view class="grades-container">
  <view class="grades-header">
    <text class="student-name">{{studentName}}</text>
    <button class="logout-btn" bindtap="onLogout" size="mini">退出</button>
  </view>

  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value">{{totalCourses}}</text>
      <text class="stat-label">总课程</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{totalCredits}}</text>
      <text class="stat-label">总学分</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{averageGrade}}</text>
      <text class="stat-label">平均分</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:elif="{{errorMsg}}" class="error-msg">{{errorMsg}}</view>

  <view wx:elif="{{grades.length === 0}}" class="empty-msg">暂无成绩数据</view>

  <scroll-view wx:else class="grades-list" scroll-y>
    <view class="grade-card" wx:for="{{grades}}" wx:key="index">
      <view class="grade-header">
        <text class="course-name">{{item.courseName}}</text>
        <text class="grade-score {{getGradeClass(item.score)}}">
          {{item.score || '未录入'}}
        </text>
      </view>
      <view class="grade-details">
        <text class="detail-item" wx:if="{{item.credit}}">
          学分: {{item.credit}}
        </text>
        <text class="detail-item" wx:if="{{item.semester}}">
          {{item.semester}}
        </text>
        <text class="detail-item" wx:if="{{item.courseNature}}">
          {{item.courseNature}}
        </text>
        <text class="detail-item" wx:if="{{item.gpa}}">
          绩点: {{item.gpa}}
        </text>
        <text class="detail-item" wx:if="{{item.examMethod}}">
          考试方式: {{item.examMethod}}
        </text>
      </view>
    </view>
  </scroll-view>
</view>
