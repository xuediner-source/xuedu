.grades-container {
  padding: 0;
  min-height: 100vh;
  background: #f5f5f5;
}

.grades-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.student-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.logout-btn {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  background: #f5f7fa;
  border: 1rpx solid #e74c3c;
  border-radius: 8rpx;
  color: #e74c3c;
}

.stats-card {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 16rpx;
  background: #fff;
  margin-bottom: 16rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a73e8;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.grades-list {
  padding: 0 16rpx;
  height: calc(100vh - 200rpx);
}

.grade-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.grade-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.course-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.grade-score {
  font-size: 36rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.grade-excellent {
  color: #27ae60;
  background: #e6f4ea;
}

.grade-good {
  color: #1a73e8;
  background: #e8f0fe;
}

.grade-pass {
  color: #e67e22;
  background: #fef7e0;
}

.grade-fail {
  color: #e74c3c;
  background: #fce8e6;
}

.grade-details {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.detail-item {
  font-size: 22rpx;
  color: #999;
  background: #f5f7fa;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.loading, .error-msg {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #999;
}

.error-msg {
  color: #e74c3c;
}
