.schedule-container {
  padding: 0;
  min-height: 100vh;
  background: #f5f5f5;
}

.schedule-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.student-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.week-info {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.semester-info, .offline-info {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.offline-info {
  color: #b26a00;
}

.header-right {
  display: flex;
  gap: 16rpx;
}

.refresh-btn, .logout-btn {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  background: #f5f7fa;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  color: #666;
}

.logout-btn {
  color: #e74c3c;
  border-color: #e74c3c;
}

.week-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  background: #fff;
  margin-bottom: 16rpx;
}

.week-nav {
  width: 60rpx;
  height: 60rpx;
  background: #f5f7fa;
  border: 1rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #666;
  line-height: 1;
}

.week-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin: 0 24rpx;
}

.schedule-grid {
  padding: 0 16rpx;
  height: calc(100vh - 200rpx);
}

.schedule-table {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

.table-row:last-child {
  border-bottom: none;
}

.table-header {
  background: #f8f9fb;
  font-weight: 600;
}

.table-cell {
  flex: 1;
  min-height: 100rpx;
  padding: 8rpx;
  border-right: 1rpx solid #f0f0f0;
  font-size: 22rpx;
  color: #666;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.table-cell:last-child {
  border-right: none;
}

.time-cell {
  flex: 0 0 80rpx;
  font-size: 20rpx;
  color: #999;
  font-weight: 500;
}

.lesson-item {
  width: 100%;
  min-height: 80rpx;
  padding: 6rpx;
  border-radius: 6rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  font-size: 20rpx;
}

.lesson-name {
  font-weight: 600;
  color: #1a73e8;
  font-size: 20rpx;
  line-height: 1.3;
}

.lesson-location {
  color: #e67e22;
  font-size: 18rpx;
  margin-top: 2rpx;
}

.lesson-teacher {
  color: #666;
  font-size: 18rpx;
  margin-top: 2rpx;
}

.lesson-weeks {
  font-size: 16rpx;
  color: #999;
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.period-time {
  font-size: 16rpx;
  color: #999;
  display: block;
}

.lesson-item {
  padding: 4rpx 4rpx;
  margin: 2rpx 0;
  border-radius: 6rpx;
  font-size: 20rpx;
  line-height: 1.2;
  overflow: hidden;
}

.lesson-weektype {
  display: inline-block;
  font-size: 14rpx;
  color: #e67e22;
  background: #fef3e2;
  padding: 1rpx 6rpx;
  border-radius: 4rpx;
  margin-top: 2rpx;
}

.loading, .error-msg {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #999;
}

.error-msg {
  color: #e74c3c;
}
