PORT=3000
BIND_HOST=127.0.0.1
TRUST_PROXY_HOPS=1
DATA_DIR=/opt/cqjtu/backend/data

# Both authentication services must use HTTPS. CAS defaults to the school identity portal.
CAS_BASE_URL=https://ids.cqjtu.edu.cn
EDU_BASE_URL=https://jwgln.cqjtu.edu.cn

# Real CAS cookie jars persist only when this is a private, random 32-byte key.
# Generate outside the repository, then keep it in the deployment secret store.
# SESSION_ENCRYPTION_KEY=<64 hex characters or base64 for 32 random bytes>
SESSION_TTL_SECONDS=1209600
UPSTREAM_TIMEOUT_MS=15000

# Fictional demo feature only; not related to the test APK release channel.
# Disabled unless explicitly enabled.
DEMO_ENABLED=0
DEMO_USER=xuedu_demo
DEMO_PASS=xuedu2026

# Optional management requires BOTH a random token and exact trusted source IPs.
# GRAY_ADMIN_TOKEN=
# GRAY_ADMIN_IPS=127.0.0.1,203.0.113.10
